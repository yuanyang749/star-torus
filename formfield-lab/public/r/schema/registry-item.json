{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://formfield-lab.vercel.app/r/schema/registry-item.json",
  "title": "FormField Registry Item",
  "type": "object",
  "required": [
    "name",
    "title",
    "description",
    "type",
    "dependencies",
    "registryDependencies",
    "files",
    "meta"
  ],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "type": {
      "enum": [
        "registry:visual",
        "registry:runtime",
        "registry:geometry"
      ]
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "devDependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "registryDependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "target",
          "type",
          "content"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "target": {
            "type": "string"
          },
          "type": {
            "enum": [
              "registry:file",
              "registry:component",
              "registry:style"
            ]
          },
          "content": {
            "type": "string"
          }
        }
      }
    },
    "meta": {
      "type": "object"
    },
    "config": {
      "type": "object"
    }
  }
}
